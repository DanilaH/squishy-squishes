{
  "name": "squishy-squishes",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:yandex": "tsc --noEmit && vite build --mode yandex",
    "verify:yandex": "node scripts/verify-yandex-dist.mjs",
    "release:check": "npm run typecheck && npm run build && npm run build:yandex && npm run verify:yandex",
    "qa:browser": "playwright test --config=playwright.release.config.ts",
    "qa:release": "npm run release:check && npm run qa:browser"
  },
  "dependencies": {
    "@danilah/mini-games-kit": "git+https://github.com/DanilaH/mini-games-kit.git#d17ba31fce2a71335dcc3095f772c3fdd87fe97b"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
